      <bpmndi:BPMNShape id="Anno_05_di" bpmnElement="Anno_05"><dc:Bounds x="1700" y="950" width="210" height="64" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_01_di" bpmnElement="Flow_01"><di:waypoint x="276" y="285" /><di:waypoint x="320" y="285" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_02_di" bpmnElement="Flow_02"><di:waypoint x="420" y="285" /><di:waypoint x="480" y="285" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_03_di" bpmnElement="Flow_03"><di:waypoint x="530" y="325" /><di:waypoint x="530" y="400" /><bpmndi:BPMNLabel><dc:Bounds x="485" y="376" width="90" height="20" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_04_di" bpmnElement="Flow_04"><di:waypoint x="580" y="440" /><di:waypoint x="705" y="440" /><di:waypoint x="705" y="310" /><bpmndi:BPMNLabel><dc:Bounds x="660" y="416" width="90" height="20" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_05_di" bpmnElement="Flow_05"><di:waypoint x="730" y="285" /><di:waypoint x="780" y="285" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_06_di" bpmnElement="Flow_06"><di:waypoint x="880" y="285" /><di:waypoint x="940" y="285" /><bpmndi:BPMNLabel><dc:Bounds x="895" y="261" width="90" height="20" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_07_di" bpmnElement="Flow_07"><di:waypoint x="990" y="325" /><di:waypoint x="990" y="530" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_08_di" bpmnElement="Flow_08"><di:waypoint x="1040" y="570" /><di:waypoint x="1100" y="570" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_09_di" bpmnElement="Flow_09"><di:waypoint x="1150" y="570" /><di:waypoint x="1210" y="570" /><bpmndi:BPMNLabel><dc:Bounds x="1165" y="546" width="90" height="20" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
