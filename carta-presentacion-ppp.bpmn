      <bpmndi:BPMNShape id="Task_PresentaEntidad_di" bpmnElement="Task_PresentaEntidad"><dc:Bounds x="1790" y="245" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Fin_di" bpmnElement="EndEvent_Fin"><dc:Bounds x="1950" y="267" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1903" y="309" width="130" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Anno_01_di" bpmnElement="Anno_01"><dc:Bounds x="480" y="950" width="200" height="64" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Anno_02_di" bpmnElement="Anno_02"><dc:Bounds x="830" y="950" width="200" height="64" /></bpmndi:BPMNShape>
