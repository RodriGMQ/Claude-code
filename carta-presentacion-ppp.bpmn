<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_CartaPPP" targetNamespace="http://unap.edu.pe/fcah/ppp" exporter="UNA Puno - FCAH" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:documentation>Trámite de emisión de la carta de presentación para prácticas pre profesionales. Escuela Profesional de Administración, Facultad de Ciencias Administrativas y Humanas, Universidad Nacional del Altiplano - Puno. Duración: 2 días hábiles. Trabajo efectivo: 78 min. Costo del tiempo de la Secretaría de Decanato: S/ 7.87 por carta.</bpmn:documentation>
    <bpmn:participant id="Participant_FCAH" name="UNA Puno · Facultad de Ciencias Administrativas y Humanas" processRef="Process_CartaPPP" />
    <bpmn:participant id="Participant_Entidad" name="Entidad receptora (empresa o entidad pública)" />
    <bpmn:messageFlow id="MsgFlow_01" name="requisitos de admisión del practicante" sourceRef="Participant_Entidad" targetRef="Task_Plaza" />
    <bpmn:messageFlow id="MsgFlow_02" name="carta de presentación firmada" sourceRef="Task_PresentaEntidad" targetRef="Participant_Entidad" />
  </bpmn:collaboration>
  <bpmn:process id="Process_CartaPPP" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Estudiante" name="Estudiante">
        <bpmn:flowNodeRef>StartEvent_Inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Plaza</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Consulta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Elabora</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Presenta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_Espera1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PresentaEntidad</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Fin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Coordinacion" name="Coordinación de Prácticas Pre Profesionales">
        <bpmn:flowNodeRef>Task_Absuelve</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Secretaria" name="Secretaría de Decanato">
        <bpmn:flowNodeRef>Task_Recepciona</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Cumple</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Observa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Cargo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Redacta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Visa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_Espera2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Entrega</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Decanato" name="Decanato · Decana de la FCAH">
        <bpmn:flowNodeRef>Task_Firma</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_Inicio" name="El estudiante requiere realizar sus PPP">
      <bpmn:documentation>Evento inicial del trámite.</bpmn:documentation>
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:manualTask id="Task_Plaza" name="Gestiona y obtiene la plaza de prácticas">
      <bpmn:documentation>Busca la empresa o entidad pública receptora y revisa los requisitos que ella exige. Tiempo variable, no medido.</bpmn:documentation>
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="Task_Consulta" name="Consulta los requisitos en Coordinación de PPP">
      <bpmn:documentation>Tiempo efectivo: 15 min del estudiante.</bpmn:documentation>
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:manualTask id="Task_Absuelve" name="Absuelve la consulta e informa los requisitos">
      <bpmn:documentation>Tiempo efectivo: 15 min de la Coordinación de Prácticas Pre Profesionales.</bpmn:documentation>
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="Gateway_Merge">
      <bpmn:documentation>Punto de reingreso del expediente observado.</bpmn:documentation>
      <bpmn:incoming>Flow_04</bpmn:incoming>
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_Elabora" name="Elabora la carta y adjunta la ficha de matrícula">
      <bpmn:documentation>Expediente: carta de presentación redactada por el estudiante más la ficha de matrícula. Tiempo variable, no medido.</bpmn:documentation>
      <bpmn:incoming>Flow_05</bpmn:incoming>
      <bpmn:outgoing>Flow_06</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Presenta" name="Presenta el expediente en Secretaría de Decanato">
      <bpmn:documentation>Tiempo efectivo: 8 min del estudiante en mostrador.</bpmn:documentation>
      <bpmn:incoming>Flow_06</bpmn:incoming>
      <bpmn:outgoing>Flow_07</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Recepciona" name="Recepciona, formula preguntas previas y verifica requisitos">
      <bpmn:documentation>Tiempo efectivo: 8 min de la Secretaría de Decanato. Costo del tiempo: S/ 1.00.</bpmn:documentation>
      <bpmn:incoming>Flow_07</bpmn:incoming>
      <bpmn:outgoing>Flow_08</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Cumple" name="¿El expediente cumple todos los requisitos?">
      <bpmn:documentation>Compuerta exclusiva: salida Sí continúa el trámite, salida No genera reproceso.</bpmn:documentation>
      <bpmn:incoming>Flow_08</bpmn:incoming>
      <bpmn:outgoing>Flow_09</bpmn:outgoing>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_Observa" name="Observa el expediente y lo devuelve al estudiante">
      <bpmn:documentation>Incluido en los 8 min del paso de recepción. Cada observación agrega 8 min de Secretaría (S/ 1.00) y un día hábil al trámite.</bpmn:documentation>
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="Event_Espera1" name="Siguiente día hábil">
      <bpmn:documentation>El estudiante corrige la observación y reingresa el expediente al día siguiente hábil.</bpmn:documentation>
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_Event_Espera1">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P1D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:manualTask id="Task_Cargo" name="Sella y firma el cargo de recepción">
      <bpmn:documentation>Incluido en los 8 min de la recepción.</bpmn:documentation>
      <bpmn:incoming>Flow_09</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="Task_Redacta" name="Redacta la carta de presentación oficial">
      <bpmn:documentation>Tiempo efectivo: 40 min de la Secretaría de Decanato. Costo del tiempo: S/ 4.99. Es la actividad más costosa del proceso.</bpmn:documentation>
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Visa" name="Traslada la carta a Decanato para su visación">
      <bpmn:documentation>Tiempo efectivo: 10 min de la Secretaría de Decanato, que cubren el traslado, la espera y la firma. Costo del tiempo: S/ 1.25.</bpmn:documentation>
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:manualTask id="Task_Firma" name="Firma y sella la carta de presentación">
      <bpmn:documentation>A cargo de la Decana de la Facultad de Ciencias Administrativas y Humanas. Estimado de 2 a 3 min, contenidos en los 10 min de la Secretaría.</bpmn:documentation>
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:intermediateCatchEvent id="Event_Espera2" name="Siguiente día hábil">
      <bpmn:documentation>La carta firmada se entrega al día siguiente hábil de presentado el expediente.</bpmn:documentation>
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_Event_Espera2">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P1D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="Task_Entrega" name="Entrega la carta firmada al estudiante">
      <bpmn:documentation>Tiempo efectivo: 5 min de la Secretaría de Decanato. Costo del tiempo: S/ 0.62.</bpmn:documentation>
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_PresentaEntidad" name="Presenta la carta a la entidad receptora">
      <bpmn:documentation>Cierra el trámite e inicia las prácticas pre profesionales.</bpmn:documentation>
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent_Fin" name="Carta presentada: inician las PPP">
      <bpmn:incoming>Flow_19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_Inicio" targetRef="Task_Plaza" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_Plaza" targetRef="Task_Consulta" />
    <bpmn:sequenceFlow id="Flow_03" name="consulta" sourceRef="Task_Consulta" targetRef="Task_Absuelve" />
    <bpmn:sequenceFlow id="Flow_04" name="requisitos informados" sourceRef="Task_Absuelve" targetRef="Gateway_Merge" />
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Gateway_Merge" targetRef="Task_Elabora" />
    <bpmn:sequenceFlow id="Flow_06" name="expediente" sourceRef="Task_Elabora" targetRef="Task_Presenta" />
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_Presenta" targetRef="Task_Recepciona" />
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Task_Recepciona" targetRef="Gateway_Cumple" />
    <bpmn:sequenceFlow id="Flow_09" name="Sí" sourceRef="Gateway_Cumple" targetRef="Task_Cargo" />
    <bpmn:sequenceFlow id="Flow_10" name="No" sourceRef="Gateway_Cumple" targetRef="Task_Observa" />
    <bpmn:sequenceFlow id="Flow_11" name="expediente observado" sourceRef="Task_Observa" targetRef="Event_Espera1" />
    <bpmn:sequenceFlow id="Flow_12" name="corrige y reingresa" sourceRef="Event_Espera1" targetRef="Gateway_Merge" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_Cargo" targetRef="Task_Redacta" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_Redacta" targetRef="Task_Visa" />
    <bpmn:sequenceFlow id="Flow_15" name="para firma" sourceRef="Task_Visa" targetRef="Task_Firma" />
    <bpmn:sequenceFlow id="Flow_16" name="carta firmada" sourceRef="Task_Firma" targetRef="Event_Espera2" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Event_Espera2" targetRef="Task_Entrega" />
    <bpmn:sequenceFlow id="Flow_18" name="carta de presentación" sourceRef="Task_Entrega" targetRef="Task_PresentaEntidad" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Task_PresentaEntidad" targetRef="EndEvent_Fin" />
    <bpmn:textAnnotation id="Anno_01"><bpmn:text>Consulta previa: 15 min. Es el paso que evita el reproceso.</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="Anno_02"><bpmn:text>Recepción, preguntas previas y verificación: 8 min · S/ 1.00</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="Anno_03"><bpmn:text>Reproceso: +1 día hábil y +8 min de Secretaría por cada observación</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="Anno_04"><bpmn:text>Redacción de la carta: 40 min · S/ 4.99. Actividad más costosa.</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="Anno_05"><bpmn:text>Entrega al siguiente día hábil: 5 min · S/ 0.62</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_Anno_01" sourceRef="Task_Absuelve" targetRef="Anno_01" />
    <bpmn:association id="Assoc_Anno_02" sourceRef="Task_Recepciona" targetRef="Anno_02" />
    <bpmn:association id="Assoc_Anno_03" sourceRef="Task_Observa" targetRef="Anno_03" />
    <bpmn:association id="Assoc_Anno_04" sourceRef="Task_Redacta" targetRef="Anno_04" />
    <bpmn:association id="Assoc_Anno_05" sourceRef="Task_Entrega" targetRef="Anno_05" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Participant_FCAH_di" bpmnElement="Participant_FCAH" isHorizontal="true"><dc:Bounds x="160" y="200" width="1880" height="700" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Estudiante_di" bpmnElement="Lane_Estudiante" isHorizontal="true"><dc:Bounds x="190" y="200" width="1850" height="170" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Coordinacion_di" bpmnElement="Lane_Coordinacion" isHorizontal="true"><dc:Bounds x="190" y="370" width="1850" height="140" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Secretaria_di" bpmnElement="Lane_Secretaria" isHorizontal="true"><dc:Bounds x="190" y="510" width="1850" height="260" /></bpmndi:BPMNShape>
